APP_ENV=development
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=incident_investigator
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/incident_investigator

BACKEND_PORT=8000
FRONTEND_PORT=5180
CORS_ORIGINS=["http://localhost:5180","http://localhost:5181","http://127.0.0.1:5180","http://127.0.0.1:5181","http://localhost:3000"]

# LLM Configuration (Use MOCK_KEY for deterministic testing, or provide Google Gemini API key)
LLM_API_KEY=MOCK_KEY
LLM_MODEL=gemini-2.0-flash
EMBEDDING_MODEL=gemini-embedding-2
# LANGSMITH_API_KEY=
